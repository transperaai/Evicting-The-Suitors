# Neon Postgres connection string (pooled)
DATABASE_URL="postgres://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# The passphrase that unlocks the house. Required in production.
APP_PASSPHRASE="choose-something-long"

# Fallback time zone if the browser hasn't told us yet (IANA name)
APP_TIMEZONE="UTC"
